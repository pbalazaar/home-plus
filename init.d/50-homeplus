#!/bin/sh
# Home+ boot script, run as root by Homebrew Channel at startup. The Home+ service links it
# into /var/lib/webosbrew/init.d/50-homeplus: a link, so it goes when Home+ does (run-parts
# skips the dead link). The name must have no extension: Homebrew Channel runs these with run-parts.
#
# 1. Elevates the Home+ service so it can list/launch apps (idempotent).
# 2. Starts the service. It watches the foreground app and replaces LG's home
#    screen with Home+ - including at boot.
# What it did goes to /var/lib/webosbrew/homeplus-boot.log (this boot's only).

APP=com.github.pmiraka.homeplus
SVC=$APP.service
SVC_DIR=/media/developer/apps/usr/palm/services/$SVC
ELEVATE=/media/developer/apps/usr/palm/services/org.webosbrew.hbchannel.service/elevate-service
LOG=/var/lib/webosbrew/homeplus-boot.log

# Home+'s service isn't installed (any more): stop, and leave the TV alone.
[ -f "$SVC_DIR/service.js" ] || { echo "homeplus: $SVC_DIR isn't installed; nothing to do" >&2; exit 0; }

(
  echo "homeplus boot $(date)"

  if [ -x "$ELEVATE" ]; then
    "$ELEVATE" "$SVC" && echo "elevated $SVC"
  else
    echo "elevate-service not found at $ELEVATE"
  fi

  # Retry until the bus answers (up to ~60s); the first answer starts the service.
  i=0
  while [ $i -lt 30 ]; do
    if luna-send -n 1 -w 3000 "luna://$SVC/ping" '{}' 2>/dev/null | grep -q '"returnValue":true'; then
      echo "service up"
      break
    fi
    i=$((i + 1))
    sleep 2
  done
) >"$LOG" 2>&1 &
